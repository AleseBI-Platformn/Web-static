# ============================================
# .dockerignore para optimizar build
# ============================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production builds
dist
build

# Environment files
.env.local
.env.development
.env.test

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs
*.log

# Git
.git
.gitignore

# Documentation
README.md
*.md
docs/

# Development files
docker-compose.yml
.eslintrc.*
.prettierrc

# Temporary files
*.tmp
*.temp

# Test files
__tests__
*.test.*
*.spec.*

# Server development (no necesario en producción)
server/

# Database dumps
*.sql
database
schemabd-real

# Configuración para cPanel (BanaHosting)
# Cambia "tudominio.com" por tu dominio real
VITE_API_MODE=production
VITE_API_BASE_URL=https://tudominio.com/prueba02/api
VITE_PHP_SERVER_URL=https://tudominio.com/prueba02

# Optimización para producción en cPanel
VITE_APP_DEBUG=false
VITE_APP_API_LOGS=false
NODE_ENV=production

# INSTRUCCIONES:
# 1. Reemplaza "tudominio.com" con tu dominio real de BanaHosting
# 2. Si cambias el nombre de "prueba02", actualiza las URLs
# 3. Usa este archivo cuando compiles para cPanel: npm run build --mode cpanel
